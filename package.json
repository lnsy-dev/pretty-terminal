{
  "name": "pretty-terminal",
  "version": "0.1.0",
  "description": "Pretty Terminal, with theme",
  "main": "electron/main.js",
  "type": "module",
  "author": "LNSY <l>",
  "license": "Unlicense",
  "keywords": [
    "electron",
    "sqlite",
    "sqlite-wasm",
    "opfs",
    "file-system-access-api",
    "custom-elements",
    "vanilla-js",
    "dataroom-js",
    "webpack"
  ],
  "scripts": {
    "start": "webpack serve",
    "build": "cross-env NODE_ENV=production webpack build",
    "prebuild": "npm run icons",
    "icons": "node scripts/generate-icons.js",
    "electron": "npm run build && node electron/dev-runner.js",
    "electron:build": "npm run build && electron-builder",
    "test": "wdio run ./wdio.conf.js",
    "test:unit": "vitest run",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "dataroom-js": "^1.0.1",
    "dotenv": "17.4.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@swc/core": "^1.9.3",
    "@wdio/cli": "^9.31.2",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "chromedriver": "^152.0.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "css-loader": "^7.1.2",
    "cssnano": "^8.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.9.2",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "vitest": "^3.2.4",
    "webdriverio": "^9.31.2",
    "webpack": "^5.107.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "build": {
    "appId": "com.prettyterminal.app",
    "productName": "Pretty Terminal",
    "icon": "assets/icons",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/logo.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lnsy-dev/pretty-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/lnsy-dev/pretty-terminal/issues"
  },
  "homepage": "https://github.com/lnsy-dev/pretty-terminal#readme",
  "allowScripts": {
    "chromedriver@152.0.2": true,
    "node-pty@1.1.0": true
  }
}
