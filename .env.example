# Output filename for the production build (default: main.min.js)
OUTPUT_FILE_NAME=main.min.js

# Development server port (default: 3000)
PORT=3000

# Extract CSS to a separate file instead of injecting it via JS (default: false)
SEPARATE_CSS=false

# URL Electron loads in development (default: http://localhost:3000)
# Set this in your shell environment when launching Electron, e.g.:
#   ELECTRON_DEV_URL=http://localhost:8080 npm run electron
ELECTRON_DEV_URL=http://localhost:3000
